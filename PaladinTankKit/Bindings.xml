<Bindings>
    <Binding name="PALADINTANKKIT_PULL" header="PALADINTANKKIT">
        PaladinTankKit_Pull()
    </Binding>
    <Binding name="PALADINTANKKIT_SKULL">
        PaladinTankKit_Mark(8)
    </Binding>
    <Binding name="PALADINTANKKIT_CROSS">
        PaladinTankKit_Mark(7)
    </Binding>
    <Binding name="PALADINTANKKIT_CLEAR">
        PaladinTankKit_Mark(0)
    </Binding>
</Bindings>
